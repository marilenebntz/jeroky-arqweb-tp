    --connect-timeout 3 --max-time 10 \
    --connect-to localhost:3443:gateway:8443 \
    --cacert /certs/localhost.crt \
    --tlsv1.3 --tls-max 1.3 \
    -o /dev/null -w "HTTP %{http_code}\n" \
    "https://localhost:3443/v2/search?q=Juana&type=student"
  i=$((i + 1))
done
