{
  "openapi": "3.1.0",
  "info": {
    "title": "Jeroky - API de exportacion",
    "version": "0.2.0",
    "description": "Genera reportes de alumnos en Markdown usando la API de Jeroky. La autenticacion de esta API y el gateway estan pendientes."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3004"
    }
  ],
  "paths": {
    "/v2/exports": {
      "post": {
        "operationId": "createExport",
        "summary": "Pedir un reporte",
        "description": "Guarda el trabajo y devuelve su identificador. El worker lo procesa despues. El cuerpo admite hasta 8192 bytes. Cada pedido crea un trabajo nuevo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "report",
                  "format"
                ],
                "properties": {
                  "report": {
                    "type": "string",
                    "const": "students"
                  },
                  "format": {
                    "type": "string",
                    "const": "markdown"
                  }
                }
              },
              "example": {
                "report": "students",
                "format": "markdown"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Trabajo guardado para procesar.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job_id",
                    "report",
                    "format",
                    "status",
                    "created_at",
                    "updated_at",
                    "error"
                  ],
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "report": {
                      "type": "string",
                      "const": "students"
                    },
                    "format": {
                      "type": "string",
                      "const": "markdown"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "completed",
                        "failed"
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Ruta para consultar el trabajo.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "El pedido no es valido.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "El pedido es demasiado grande.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Se debe enviar application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "No se pudo guardar el trabajo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/exports/{job_id}": {
      "get": {
        "operationId": "getExport",
        "summary": "Consultar un trabajo",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado del trabajo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job_id",
                    "report",
                    "format",
                    "status",
                    "created_at",
                    "updated_at",
                    "error"
                  ],
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "report": {
                      "type": "string",
                      "const": "students"
                    },
                    "format": {
                      "type": "string",
                      "const": "markdown"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "completed",
                        "failed"
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "El trabajo no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "No se pudo consultar el trabajo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/exports/{job_id}/download": {
      "get": {
        "operationId": "downloadExport",
        "summary": "Descargar el reporte",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo Markdown generado.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "Indica el nombre del archivo adjunto."
              }
            },
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "El trabajo no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "El trabajo no esta completado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "No se pudo obtener el archivo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getExportHealth",
        "summary": "Consultar la salud de la API",
        "description": "Comprueba HTTP y SELECT 1 en SQLite. La conexion con Jeroky y el avance del worker necesitan comprobaciones adicionales.",
        "responses": {
          "200": {
            "description": "La consulta funciona.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    },
                    "database": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Fallo al consultar SQLite.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getExportLiveness",
        "summary": "Comprobar que el proceso HTTP está vivo",
        "responses": {
          "200": {
            "description": "Vivo, sin consultar dependencias",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "const": "alive"
                    },
                    "service": {
                      "const": "export-svc"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getExportMetrics",
        "summary": "Contador HTTP e histograma de latencia en formato Prometheus",
        "responses": {
          "200": {
            "description": "Métricas del proceso desde su último arranque",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getExportReadiness",
        "summary": "Comprobar lectura y escritura de trabajos; no verifica worker ni Jeroky",
        "responses": {
          "200": {
            "description": "SQLite permite aceptar trabajos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "not_ready"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "unavailable"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "SQLite no permite aceptar trabajos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "not_ready"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "unavailable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
