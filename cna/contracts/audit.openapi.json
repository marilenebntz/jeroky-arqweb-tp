{
  "openapi": "3.1.0",
  "info": {
    "title": "Jeroky - API de auditoria",
    "version": "0.2.0",
    "description": "API local de laboratorio. La autenticacion y la integracion con el gateway estan pendientes."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3002"
    }
  ],
  "paths": {
    "/v2/audit": {
      "get": {
        "operationId": "listAuditEvents",
        "summary": "Consultar eventos de auditoria",
        "description": "Combina los filtros por igualdad mediante AND. Ordena por stored_at descendente y event_id descendente. Un filtro sin coincidencias devuelve HTTP 200 con total 0 e items vacio. Los desplazamientos de paginacion deben ser enteros seguros de JavaScript.",
        "parameters": [
          {
            "name": "entity_type",
            "in": "query",
            "description": "Tipo de entidad en el payload del evento.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entity_id",
            "in": "query",
            "description": "Identificador de entidad en el payload del evento.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 20,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pagina de eventos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "page",
                    "limit",
                    "total",
                    "items"
                  ],
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "event",
                          "stored_at"
                        ],
                        "properties": {
                          "event": {
                            "$ref": "./event-envelope.schema.json"
                          },
                          "stored_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Paginacion invalida.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Fallo al consultar auditoria.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getAuditHealth",
        "summary": "Comprobar HTTP y conexion con SQLite",
        "description": "Ejecuta SELECT 1. La comprobacion de RabbitMQ, las tablas y la capacidad de escritura esta pendiente.",
        "responses": {
          "200": {
            "description": "Comprobacion exitosa.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    },
                    "database": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Fallo de la comprobacion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getAuditLiveness",
        "summary": "Comprobar que el proceso HTTP está vivo",
        "responses": {
          "200": {
            "description": "Vivo, sin consultar dependencias",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "const": "alive"
                    },
                    "service": {
                      "const": "audit-svc"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getAuditReadiness",
        "summary": "Comprobar tablas, escritura reversible y consumidor conectado",
        "description": "Estado local AMQP confirmado al iniciar consumidor, invalidado al detectar error o cierre. No es un ping independiente al broker en cada petición ni garantiza detección instantánea de una partición de red.",
        "responses": {
          "200": {
            "description": "Preparado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database",
                    "rabbitmq"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "ready",
                        "not_ready"
                      ]
                    },
                    "database": {
                      "enum": [
                        "ok",
                        "unavailable"
                      ]
                    },
                    "rabbitmq": {
                      "enum": [
                        "connected",
                        "unavailable"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Dependencia no preparada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database",
                    "rabbitmq"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "ready",
                        "not_ready"
                      ]
                    },
                    "database": {
                      "enum": [
                        "ok",
                        "unavailable"
                      ]
                    },
                    "rabbitmq": {
                      "enum": [
                        "connected",
                        "unavailable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getAuditMetrics",
        "summary": "Contador HTTP e histograma de latencia en formato Prometheus",
        "responses": {
          "200": {
            "description": "Métricas del proceso desde su último arranque",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
