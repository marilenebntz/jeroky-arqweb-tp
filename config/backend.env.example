# Ejemplo de variables de entorno del backend (jerokybackend/.env)
# Todos los valores son de ejemplo/desarrollo; ninguno es un secreto real.

# Base de datos
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<definir_en_.env_local>
DATABASE_NAME=jeroky_soft_db

# JWT y seguridad
JWT_SECRET=<definir_en_.env_local>
JWT_EXPIRATION=1d
ENCRYPTION_KEY=<definir_en_.env_local>

# AWS Rekognition (Face ID)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<definir_en_.env_local>
AWS_SECRET_ACCESS_KEY=<definir_en_.env_local>
AWS_REKOGNITION_COLLECTION_ID=jeroky-faces-collection

# Brevo (email transaccional)
BREVO_API_KEY=<definir_en_.env_local>
BREVO_SENDER_EMAIL=notificaciones@tu-dominio-verificado.com
BREVO_SENDER_NAME="Centro de Danzas Jeroky Paraguai"

# Puerto de la aplicación (dentro del contenedor)
PORT=3000
